# 複製為 .env.local 後，依每台實體電腦修改。不要把 .env.local 加入 Git。
LGSALEOUT_ENV=LGDevA
LGSALEOUT_PORT=8097
LGSALEOUT_RP_ID=lgdeva.example.com
LGSALEOUT_RP_NAME=LGSale
LGSALEOUT_ORIGIN=https://lgdeva.example.com

LGSALEOUT_DB_HOST=127.0.0.1
LGSALEOUT_DB_PORT=1433
LGSALEOUT_DB_NAME=LGSaleOut
LGSALEOUT_DB_USER=CHANGE_ME
LGSALEOUT_DB_PASSWORD=CHANGE_ME

LGSALEOUT_SESSION_SECRET_FILE=.lgsale-session-secret
LGSALEOUT_CLOUDFLARE_SERVICE=Cloudflared-LGDevA
