          <mxGeometry x="62" y="986" width="1518" height="23" as="geometry" />
        </mxCell>
        <mxCell id="c78" value="• 管理無權授予 Designer，也無權修改本頁；變更應留下修改者、時間及前後內容。" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203448;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=9;" vertex="1" parent="1">
          <mxGeometry x="62" y="1011" width="1518" height="23" as="geometry" />
