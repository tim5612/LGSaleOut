        <mxCell id="c60" value="• Menu 只顯示巡店任務與 PSI；隱藏人員、經銷商、匯入、Passkey 與權限設定。" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203448;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=9;" vertex="1" parent="1">
          <mxGeometry x="62" y="961" width="1518" height="23" as="geometry" />
        </mxCell>
        <mxCell id="c61" value="• 資料範圍必須由後端判定，不能依靠畫面篩選或隱藏按鈕。" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#203448;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=9;" vertex="1" parent="1">
          <mxGeometry x="62" y="986" width="1518" height="23" as="geometry" />
        </mxCell>
        <mxCell id="c62" value="待討論：任務建立／修改與手機回報的細項操作權限，可由 Designer 再分別設定。" style="rounded=0;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#9A5F0A;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=9;" vertex="1" parent="1">
          <mxGeometry x="62" y="1013" width="1518" height="24" as="geometry" />
        </mxCell>
      </root>
