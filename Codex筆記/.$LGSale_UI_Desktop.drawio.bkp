        <mxCell id="tabs-548" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#172B3A;fontSize=18;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontStyle=1;" value="TWCode＋經銷商名稱篩選" vertex="1">
          <mxGeometry height="34" width="1320" x="1520.0" y="2560.0" as="geometry" />
        </mxCell>
        <mxCell id="tabs-549" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#667085;fontSize=14;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="下拉選項同時呈現代碼與名稱，例如 TW010429A1　金亞，支援輸入任一項搜尋。&lt;br&gt;庫存、經銷商及配對依經銷商篩選；業務與產品顯示與該經銷商相關的新增項目。" vertex="1">
          <mxGeometry height="64" width="1320" x="1520.0" y="2600.0" as="geometry" />
        </mxCell>
        <mxCell id="tabs-550" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E1E8;fontColor=#172B3A;fontSize=13;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="" vertex="1">
          <mxGeometry height="124" width="1380" x="1504.0" y="2700.0" as="geometry" />
        </mxCell>
        <mxCell id="tabs-551" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#172B3A;fontSize=18;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontStyle=1;" value="主檔確認" vertex="1">
          <mxGeometry height="34" width="1320" x="1520.0" y="2708.0" as="geometry" />
        </mxCell>
        <mxCell id="tabs-552" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#667085;fontSize=14;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="經銷商與業務正常應已建立；未對應時先確認主檔，需要新增的資料才出現在對應頁籤。&lt;br&gt;必要欄位或配對衝突未處理完成，不開放確認匯入。" vertex="1">
          <mxGeometry height="64" width="1320" x="1520.0" y="2748.0" as="geometry" />
        </mxCell>
        <mxCell id="tabs-553" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E1E8;fontColor=#172B3A;fontSize=13;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="" vertex="1">
