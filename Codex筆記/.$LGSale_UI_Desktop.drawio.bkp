        <mxCell id="prevh2" value="&lt;b style=&quot;font-size:17px&quot;&gt;發布摘要&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontColor=#1D2939;spacingLeft=22;" vertex="1" parent="1"><mxGeometry x="1037" y="229" width="330" height="40" as="geometry"/></mxCell>
        <mxCell id="summary2" value="&lt;b&gt;新機上市展示布置&lt;/b&gt;&lt;br&gt;&lt;br&gt;執行期間　2026/08/05 – 08/16&lt;br&gt;執行範圍　全部有效經銷商&lt;br&gt;預估待辦　32 家／18 位負責人&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#667085&quot;&gt;發布後任務建立者固定為林怡君；後續修改只更新最後修改者。&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#D9E1E8;fontColor=#344054;align=left;verticalAlign=top;spacing=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1058" y="280" width="320" height="210" as="geometry"/></mxCell>
        <mxCell id="sampleinfo2" value="&lt;b&gt;樣本流程&lt;/b&gt;&lt;br&gt;&lt;br&gt;發布時可先不指定樣本。收到任一經銷商回報後，可在桌機版挑選候選執行、檢視照片、指定並核准樣本。核准後，其他執行者必須逐張對照樣本。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#F3D58B;fontColor=#694A00;align=left;verticalAlign=top;spacing=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1058" y="510" width="320" height="160" as="geometry"/></mxCell>
