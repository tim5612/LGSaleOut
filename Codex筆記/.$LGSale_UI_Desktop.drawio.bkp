        <mxCell id="range2" value="&lt;b&gt;2. 執行範圍&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#667085&quot;&gt;發布時依 2026/08/05 生效的負責關係產生待辦&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#D9E1E8;fontColor=#1D2939;align=left;spacingLeft=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="305" y="688" width="678" height="66" as="geometry"/></mxCell>
        <mxCell id="scope2" value="◉ 全部有效經銷商（32 家）　　○ 指定處所／經銷商" style="text;html=1;align=left;verticalAlign=middle;fontColor=#344054;fontSize=13;" vertex="1" parent="1"><mxGeometry x="322" y="760" width="600" height="32" as="geometry"/></mxCell>
