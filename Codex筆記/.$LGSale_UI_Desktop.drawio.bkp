        <mxCell id="tabs-547" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9E1E8;fontColor=#172B3A;fontSize=13;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="" vertex="1">
