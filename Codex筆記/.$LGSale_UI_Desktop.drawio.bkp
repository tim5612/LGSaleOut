        <mxCell id="tabs-554" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#172B3A;fontSize=18;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;fontStyle=1;" value="最後操作：取消匯入／確認匯入" vertex="1">
          <mxGeometry height="34" width="1320" x="1520.0" y="2856.0" as="geometry" />
        </mxCell>
        <mxCell id="tabs-555" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#667085;fontSize=14;fontFamily=Microsoft JhengHei;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="取消匯入：離開本次預覽，不寫入 DB。確認匯入：直接寫入 DB，不再增加第二個確認視窗。&lt;br&gt;按下後停用重複提交，成功顯示實際匯入筆數與數量；失敗整批回滾並保留預覽。" vertex="1">
          <mxGeometry height="64" width="1320" x="1520.0" y="2896.0" as="geometry" />
        </mxCell>
