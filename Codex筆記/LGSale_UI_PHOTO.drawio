      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="LGSale 任務照片 UI｜流程總圖（Photo Wireframe v0.1）" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1100" height="40" as="geometry"/></mxCell>
        <mxCell id="sub" value="範圍：建立 VisitTaskExecution → 判斷樣本狀態 → 拍攝 1:1 → 預覽／微調 → 上傳 → 正式送出" style="text;html=1;fontSize=14;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="s1" value="任務發布&#xa;系統建立&#xa;VisitTaskExecution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="業務開啟任務&#xa;確認 DealerId 與&#xa;ResponsibleEmployeeId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="decision" value="任務照片模式？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="170" height="130" as="geometry"/></mxCell>
        <mxCell id="sampleBuild" value="樣本建立中&#xa;建立樣本照片項目&#xa;SampleTaskPhotoId = NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="65" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="withSample" value="已有核准樣本&#xa;逐張比照樣本拍攝&#xa;SampleTaskPhotoId = 樣本 TaskPhotoId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="190" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="noSample" value="無樣本模式&#xa;一般任務拍照&#xa;SampleTaskPhotoId = NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="325" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="capture" value="1:1 取景 UI&#xa;拍攝時顯示正方形安全框&#xa;來源可為直式或橫式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#666666;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1190" y="180" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="crop" value="快門後自動裁切&#xa;預設中央 1:1&#xa;必要時由使用者微調" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1510" y="180" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="output" value="輸出 1200 × 1200 px&#xa;預覽確認後上傳&#xa;建立 VisitTaskPhoto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1510" y="365" width="210" height="110" as="geometry"/></mxCell>
