          <mxGeometry x="50" y="570" width="1670" height="48" as="geometry" />
        </mxCell>
        <mxCell id="choiceBody" value="採用「拍攝時即顯示 1:1 取景框＋快門後自動中央裁切＋必要時才讓使用者微調」。&#xa;&#xa;原因：Web 自訂相機可控制畫面上的正方形取景框，但不同手機與原生相機不一定能直接輸出正方形檔案。自動裁切能讓大多數使用者直接確認，不必每張手動裁切；遇到主體偏移時仍可拖曳或縮放補救。正式檔案統一輸出 1200 × 1200 px，照片報告即可固定排列。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2fff2;strokeColor=#82b366;align=left;verticalAlign=top;spacing=16;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="618" width="1670" height="155" as="geometry" />
        </mxCell>
        <mxCell id="sizeRule" value="本檔所有手機外框尺寸固定為 360 × 760；內部內容區依同一比例設計。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="50" y="820" width="1670" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
