        <mxCell id="pk-side-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=16;" value="其他失效狀態不能誤判為「設定完成」" vertex="1">
