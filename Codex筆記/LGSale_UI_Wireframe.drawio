          <mxGeometry height="135" width="135" x="238" y="2015" as="geometry" />
        </mxCell>
        <mxCell id="desktop-flow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fff2;strokeColor=#82b366;align=left;verticalAlign=top;spacing=14;fontSize=14;" value="&lt;b&gt;不需要把一次性註冊網址傳到電腦&lt;/b&gt;&#xa;&#xa;1. 電腦開啟固定的員工登入網址&#xa;2. 電腦顯示一次性的授權 QR Code&#xa;3. 手機掃描並以 Passkey／Face ID 確認&#xa;4. 電腦自動登入，進入自己的 PSI 或其他授權功能&#xa;&#xa;完成頁另提供「複製／分享固定登入網址」作為備用。" vertex="1">
          <mxGeometry height="260" width="270" x="580" y="1810" as="geometry" />
        </mxCell>

        <mxCell id="manager-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=17;align=left;spacingLeft=14;" value="經理｜手機驗證成功，但沒有手機作業權限" vertex="1">
          <mxGeometry height="46" width="800" x="925" y="1680" as="geometry" />
        </mxCell>
        <mxCell id="manager-phone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="455" width="350" x="925" y="1745" as="geometry" />
