        <mxCell id="desktop-title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=17;align=left;spacingLeft=14;" value="業務｜從手機延伸到桌機查看自己的 PSI" vertex="1">
