        <mxCell id="p1card1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=12;fontSize=14;" value="今日建議巡店　3&#xa;台北大同電器　上次 18 天前&#xa;宏達家電　　　上次 12 天前" vertex="1">
