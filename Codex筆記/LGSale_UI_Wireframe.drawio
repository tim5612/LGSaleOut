        <mxCell id="desktop-url" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#d9e1e8;align=left;spacingLeft=12;fontColor=#667085;fontSize=12;" value="https://lgsale.example/login/employee" vertex="1">
