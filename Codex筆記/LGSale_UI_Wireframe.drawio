        <mxCell id="p1head" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontStyle=1;fontSize=16;" value="LGSale　　我的工作台　　☰" vertex="1">
