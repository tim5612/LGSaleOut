        <mxCell id="rules" value="狀態處理原則" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="570" width="980" height="42" as="geometry" />
        </mxCell>
        <mxCell id="rulesbody" value="• 後端權限結果優先，不能只依前端按鈕是否顯示。&#xa;• 逾期後欄位唯讀，不以停用按鈕掩蓋既有資料。&#xa;• 作廢屬管理操作，需二次確認並說明對庫存計算的影響。&#xa;• 是否支援離線／本機草稿尚待決定；若不支援，移除「儲存草稿」選項。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=14;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="500" y="612" width="980" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ui-photo-modes" name="07_任務拍照_三種介面">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="VisitTaskPhoto｜任務拍照三種 UI（Wireframe v0.3）" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="比較：有核准樣本、沒有樣本、樣本任務建立中。拍照介面依任務狀態呈現不同引導。" style="text;html=1;fontSize=14;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1200" height="30" as="geometry"/></mxCell>

        <mxCell id="zone1" value="A｜有樣本任務：一般業務依核准樣本逐項拍攝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="105" width="620" height="48" as="geometry"/></mxCell>
        <mxCell id="aPhone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="360" height="760" as="geometry"/></mxCell>
        <mxCell id="aHead" value="×　① 跳跳牌照片　　 1／3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#555555;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="85" y="210" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="aCamera" value="1 : 1 即時取景框&#xa;輸出 1200 × 1200 px&#xa;&#xa;┌ ─ ─ 樣本構圖參考框 ─ ─ ┐&#xa;│　　　　　　　　　　　　│&#xa;└ ─ ─ ─ ─ ─ ─ ─ ─ ─ ┘" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#82b366;strokeWidth=2;fontColor=#ffffff;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="260" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="aSample" value="樣本縮圖&#xa;[核准樣本照片]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="105" height="85" as="geometry"/></mxCell>
        <mxCell id="aHint" value="請比照樣本拍攝跳跳牌全貌&#xa;直拍或橫拍皆置入正方形取景框" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#777777;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="620" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="aGallery" value="▧" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#aaaaaa;fontColor=#ffffff;fontSize=24;" vertex="1" parent="1"><mxGeometry x="105" y="765" width="55" height="55" as="geometry"/></mxCell>
        <mxCell id="aShutter" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;strokeWidth=6;" vertex="1" parent="1"><mxGeometry x="220" y="750" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="aFlash" value="⚡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#aaaaaa;fontColor=#ffffff;fontSize=22;" vertex="1" parent="1"><mxGeometry x="340" y="765" width="55" height="55" as="geometry"/></mxCell>
        <mxCell id="aSpec" value="資料對應&#xa;一般照片.SampleTaskPhotoId&#xa;＝畫面所示樣本.TaskPhotoId&#xa;&#xa;照片說明與 SortOrder 從樣本讀取，業務不可修改。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fff2;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="250" width="190" height="190" as="geometry"/></mxCell>
        <mxCell id="aPreview" value="拍照後預覽&#xa;&#xa;[本次照片]　[核准樣本]&#xa;　左右對照／滑動比較&#xa;&#xa;[重拍]　　　[使用照片]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="455" y="480" width="190" height="205" as="geometry"/></mxCell>

        <mxCell id="zone2" value="B｜沒有樣本任務：一般拍照，不建立樣本照片對應" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="725" y="105" width="620" height="48" as="geometry"/></mxCell>
        <mxCell id="bPhone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="755" y="175" width="360" height="760" as="geometry"/></mxCell>
        <mxCell id="bHead" value="×　拍攝任務照片　　　完成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#555555;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="770" y="210" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="bCamera" value="1 : 1 即時取景框&#xa;輸出 1200 × 1200 px&#xa;&#xa;畫面顯示水平線與九宮格&#xa;沒有樣本縮圖或構圖框" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#777777;fontColor=#ffffff;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="260" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="bHint" value="任務說明：拍攝完成後的展示全貌&#xa;直拍或橫拍皆使用正方形裁切" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#777777;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="790" y="620" width="290" height="55" as="geometry"/></mxCell>
        <mxCell id="bGallery" value="▧ 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#aaaaaa;fontColor=#ffffff;fontSize=18;" vertex="1" parent="1"><mxGeometry x="790" y="765" width="55" height="55" as="geometry"/></mxCell>
        <mxCell id="bShutter" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;strokeWidth=6;" vertex="1" parent="1"><mxGeometry x="905" y="750" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="bFlash" value="⚡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#aaaaaa;fontColor=#ffffff;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1025" y="765" width="55" height="55" as="geometry"/></mxCell>
        <mxCell id="bSpec" value="資料對應&#xa;VisitTaskPhoto.SampleTaskPhotoId = NULL&#xa;&#xa;此模式沒有逐項樣本限制；照片數量與是否允許此任務模式仍需由任務規則決定。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="190" height="190" as="geometry"/></mxCell>
        <mxCell id="bPreview" value="照片列&#xa;&#xa;[照片 1]　✓&#xa;[照片 2]　✓&#xa;＋ 再拍一張&#xa;&#xa;[刪除]　[完成]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="190" height="205" as="geometry"/></mxCell>

        <mxCell id="zone3" value="C｜樣本任務建立中：樣本製作者建立拍攝項目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1410" y="105" width="620" height="48" as="geometry"/></mxCell>
        <mxCell id="cPhone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="175" width="360" height="760" as="geometry"/></mxCell>
        <mxCell id="cHead" value="×　建立樣本照片　　 2／3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#555555;fontColor=#ffffff;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1455" y="210" width="330" height="50" as="geometry"/></mxCell>
        <mxCell id="cCamera" value="1 : 1 即時取景框&#xa;輸出 1200 × 1200 px&#xa;&#xa;拍攝將來提供所有業務&#xa;比照執行的核准樣本" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#9673a6;fontColor=#ffffff;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1455" y="260" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="cDesc" value="樣本項目名稱（必填）&#xa;[ 製冰盒照片　　　　　　　 ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#9673a6;fontColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1475" y="630" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="cHint" value="拍攝提示（畫面說明）&#xa;[ 須包含完整產品與價卡　　　 ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#777777;fontColor=#ffffff;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1475" y="710" width="290" height="70" as="geometry"/></mxCell>
        <mxCell id="cShutter" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dddddd;strokeWidth=6;" vertex="1" parent="1"><mxGeometry x="1580" y="805" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="cSpec" value="建立樣本照片時&#xa;SampleTaskPhotoId = NULL&#xa;PhotoDescription 必填&#xa;SortOrder 必填&#xa;&#xa;完成後仍為「待核准」，尚不可供一般業務執行。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf7fb;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1825" y="250" width="190" height="210" as="geometry"/></mxCell>
        <mxCell id="cPreview" value="拍照後&#xa;&#xa;[重拍]&#xa;[使用並設定項目]&#xa;&#xa;下一步：排序與送審" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1825" y="500" width="190" height="180" as="geometry"/></mxCell>

        <mxCell id="ruleTitle" value="拍照共通設計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="1990" height="42" as="geometry"/></mxCell>
        <mxCell id="ruleBody" value="• 所有任務照片統一為 1:1，儲存解析度 1200 × 1200 px；來源為直式或橫式皆在預覽階段裁切。　• 拍照後先預覽，不立即上傳正式資料。&#xa;• 支援重拍、刪除、裝置相簿選取及上傳失敗重試。　• CapturedAt 使用照片拍攝時間；UploadedAt 使用伺服器接收時間。&#xa;• 圖片上傳前顯示壓縮進度；離開未完成畫面時提示。　• 一般照片不可修改由樣本帶入的 PhotoDescription 與 SortOrder。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="1027" width="1990" height="105" as="geometry"/></mxCell>

        <mxCell id="aPreviewTitle" value="07-A｜有樣本任務－拍照後預覽 UI（完整畫面）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=18;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1990" height="48" as="geometry"/></mxCell>
        <mxCell id="apPhone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="1260" width="390" height="760" as="geometry"/></mxCell>
        <mxCell id="apHead" value="‹　預覽照片　　　　　1／3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#555555;fontColor=#ffffff;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="105" y="1300" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="apName" value="① 跳跳牌照片" style="text;html=1;fontColor=#ffffff;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="1370" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="apSquare" value="1 : 1 照片預覽／裁切區&#xa;1200 × 1200 px&#xa;&#xa;↔ 單指拖曳調整位置&#xa;⇱ 雙指縮放調整大小&#xa;&#xa;正方形以外的來源影像不會輸出" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444444;strokeColor=#82b366;strokeWidth=3;fontColor=#ffffff;fontSize=15;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1410" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="apSafe" value="─ 建議安全範圍 ─" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d5e8d4;dashed=1;fontColor=#d5e8d4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="155" y="1445" width="260" height="260" as="geometry"/></mxCell>
        <mxCell id="apTools" value="↶ 旋轉　　⊞ 重設裁切　　☀ 亮度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#777777;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="1760" width="330" height="42" as="geometry"/></mxCell>
        <mxCell id="apCompare" value="查看樣本對照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#82b366;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="1820" width="330" height="45" as="geometry"/></mxCell>
        <mxCell id="apRetake" value="重拍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#222222;strokeColor=#ffffff;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="1890" width="145" height="55" as="geometry"/></mxCell>
        <mxCell id="apUse" value="使用照片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="305" y="1890" width="145" height="55" as="geometry"/></mxCell>

        <mxCell id="comparePhone" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="1260" width="430" height="760" as="geometry"/></mxCell>
        <mxCell id="compareHead" value="‹　樣本對照　　　　　關閉" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="575" y="1300" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="compareSample" value="核准樣本&#xa;&#xa;[ 1:1 樣本照片 ]&#xa;&#xa;1200 × 1200" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="595" y="1380" width="170" height="260" as="geometry"/></mxCell>
        <mxCell id="compareCurrent" value="本次照片&#xa;&#xa;[ 1:1 裁切結果 ]&#xa;&#xa;1200 × 1200" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;" vertex="1" parent="1"><mxGeometry x="785" y="1380" width="170" height="260" as="geometry"/></mxCell>
        <mxCell id="compareNote" value="拍攝要求&#xa;• 跳跳牌需完整入鏡&#xa;• 正面拍攝，避免過度傾斜&#xa;• 文字與產品不可被裁掉" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="595" y="1670" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="compareBack" value="返回調整照片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=15;" vertex="1" parent="1"><mxGeometry x="595" y="1830" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="compareUse" value="確認使用照片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="785" y="1830" width="170" height="55" as="geometry"/></mxCell>

        <mxCell id="apFlowTitle" value="預覽處理流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1060" y="1260" width="930" height="45" as="geometry"/></mxCell>
        <mxCell id="apF1" value="取得相機原圖&#xa;直式／橫式皆可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="1350" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="apF2" value="顯示 1:1&#xa;正方形裁切框" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="1350" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="apF3" value="使用者移動／縮放&#xa;並與樣本比較" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1550" y="1350" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="apF4" value="輸出並壓縮為&#xa;1200 × 1200 px" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1790" y="1350" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="apE1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="apF1" target="apF2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apE2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="apF2" target="apF3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apE3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="apF3" target="apF4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apRules" value="預覽 UI 規則&#xa;&#xa;1. 預覽區必須是真正的正方形，不只是用遮罩模擬。&#xa;2. 來源照片不足 1200 × 1200 時禁止放大偽造解析度，提示重新拍攝。&#xa;3. 使用者確認前不寫入 VisitTaskPhoto。&#xa;4. 確認後產生 1200 × 1200 輸出，保留正確 EXIF 旋轉方向後再移除不必要的 EXIF。&#xa;5. 本次一般照片的 SampleTaskPhotoId 指向目前正在比照的核准樣本照片。&#xa;6. 報告畫面直接使用相同正方形縮圖排列，不再二次裁切。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=14;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="1490" width="870" height="285" as="geometry"/></mxCell>
        <mxCell id="apDecision" value="建議：拍攝當下即顯示 1:1 取景框，但仍保留少量原圖範圍供拍後微調；正式上傳與報告只保存／使用確認後的 1200 × 1200 正方形版本。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2fff2;strokeColor=#82b366;fontStyle=1;align=left;verticalAlign=top;spacing=14;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="1820" width="870" height="90" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
