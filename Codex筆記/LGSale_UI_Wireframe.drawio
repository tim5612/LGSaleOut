        </mxCell>
        <mxCell id="manager-icon" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#8a6100;fontSize=26;fontStyle=1;" value="i" vertex="1">
          <mxGeometry height="64" width="64" x="1068" y="1825" as="geometry" />
        </mxCell>
        <mxCell id="manager-head" parent="1" style="text;html=1;fontSize=21;fontStyle=1;align=center;" value="請使用電腦版" vertex="1">
